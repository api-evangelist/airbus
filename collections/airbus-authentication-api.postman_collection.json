{
  "item": [
    {
      "id": "55c0edc9-f166-4a3b-95ad-c9e25362dac3",
      "name": "Authentication",
      "description": {
        "content": "",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6a2901f2-9dd4-41a9-8447-6ebe123057a8",
          "name": "Exchange API key for bearer access token",
          "request": {
            "name": "Exchange API key for bearer access token",
            "description": {
              "content": "POST your OneAtlas API key to obtain a short-lived bearer access token\n(1 hour) used by all downstream OneAtlas product APIs.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "realms",
                "IDP",
                "protocol",
                "openid-connect",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) Your OneAtlas API key."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Service group identifier - use \"IDP\" for OneAtlas data services or \"AAA\" for API key management."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ]
            }
          },
          "response": [
            {
              "id": "c9f3e6f0-7062-4639-ab65-4186071dcc9c",
              "name": "Access token issued",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "realms",
                    "IDP",
                    "protocol",
                    "openid-connect",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Your OneAtlas API key.",
                        "type": "text/plain"
                      },
                      "key": "apikey",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Service group identifier - use \"IDP\" for OneAtlas data services or \"AAA\" for API key management.",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"expires_in\": 3600,\n  \"token_type\": \"bearer\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://authenticate.foundation.api.oneatlas.airbus.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "8d666089-d81d-4a54-b3d6-813f681dc625",
    "name": "Airbus OneAtlas API () Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Best-effort OpenAPI 3.1 representation of the Airbus OneAtlas developer\nportal authentication and core catalog touch points, derived from\nhttps://api.oneatlas.airbus.com/. OneAtlas exposes multiple product APIs\n(OAD Living Library, Pay Per Order Archives, Pay Per Order Tasking, Basemap,\nRadar & Elevation) which share a Keycloak-based access token flow. Only\nthe authentication endpoint and high-level catalog grouping are documented\nhere because the underlying product endpoint paths are not enumerated in\npublic introductory material.\n\n\nContact Support:\n Name: Airbus OneAtlas",
      "type": "text/plain"
    }
  }
}