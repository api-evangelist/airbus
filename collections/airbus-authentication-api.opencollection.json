{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airbus OneAtlas API () Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange API key for bearer access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://authenticate.foundation.api.oneatlas.airbus.com/auth/realms/IDP/protocol/openid-connect/token",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "apikey",
                  "value": ""
                },
                {
                  "name": "client_id",
                  "value": ""
                },
                {
                  "name": "grant_type",
                  "value": ""
                }
              ]
            }
          },
          "docs": "POST your OneAtlas API key to obtain a short-lived bearer access token\n(1 hour) used by all downstream OneAtlas product APIs.\n"
        }
      ]
    }
  ],
  "bundled": true
}