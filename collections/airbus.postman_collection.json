      "item": [
        {
          "id": "3de12fd9-59cf-4f81-a4d2-3b14466eca91",
          "name": "Exchange API key for bearer access token",
          "request": {
            "name": "Exchange API key for bearer access token",
            "description": {
              "content": "POST your OneAtlas API key to obtain a short-lived bearer access token\n(1 hour) used by all downstream OneAtlas product APIs.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "realms",
                "IDP",
                "protocol",
                "openid-connect",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "apikey",
                  "value": "<string>",
                  "description": "(Required) Your OneAtlas API key."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Service group identifier - use \"IDP\" for OneAtlas data services or \"AAA\" for API key management."
                },
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ]
            }
          },
          "response": [
            {
              "id": "cd1cc96a-4c76-41d1-be97-27330afe7ba5",
              "name": "Access token issued",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "realms",
                    "IDP",
                    "protocol",
                    "openid-connect",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Your OneAtlas API key.",
                        "type": "text/plain"
                      },
                      "key": "apikey",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Service group identifier - use \"IDP\" for OneAtlas data services or \"AAA\" for API key management.",
                        "type": "text/plain"
                      },
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"expires_in\": 3600,\n  \"token_type\": \"bearer\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
