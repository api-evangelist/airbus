          "request": {
            "name": "Catalog OpenSearch (Living Library and archives)",
            "description": {
              "content": "Search OneAtlas satellite imagery catalog using OpenSearch parameters\nsuch as `bbox`, `startDate`, `endDate`, `productType`, `cloudCover` and\n`constellation`. Requires bearer token authentication.\n",
              "type": "text/plain"
            },
            "url": {
